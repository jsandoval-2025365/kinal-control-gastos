# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_system?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"

# Sesiones (PostgreSQL) - duración de la sesión y de la cookie
SESSION_TTL_HOURS="24"

# Margen de gracia (segundos) tras expirar el JWT para renovarlo sin login
SESSION_REFRESH_GRACE_SECONDS="60"

# CSRF (double-submit cookie)
CSRF_SECRET="replace-with-another-long-random-string"

# CORS
CORS_ORIGIN="http://localhost:4200"

# Entorno
NODE_ENV="development"
PORT="3000"

# Seed del primer administrador (solo se usa al ejecutar el seed, no en runtime)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
